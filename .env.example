# Optional: ONLY populate locally. Never commit your .env file.
# A Twilio-capable phone number purchased/configured in your account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Your OWN destination phone number, in E.164 format (+1...)
TWILIO_TO_NUMBER=

# Optional settings. Local UI listens only on 127.0.0.1 by default.
TRAFFIC_OUTPUT_DIR=outputs
TRAFFIC_MAX_UPLOAD_MB=500
